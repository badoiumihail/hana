# Git only treats `#` as a comment at the start of a line, so every comment
# sits on its own line above the pattern it explains.
# A pattern without a leading `/` matches at any depth (root and inside apps/*).

# ─── Dependencies ────────────────────────────────────────────────────────────

# Installed packages. Recreated from pnpm-lock.yaml by `pnpm install`;
# huge, platform-specific, and never edited by hand.
node_modules/

# A pnpm content store, if one is ever placed inside the repo
# (e.g. by CI caching). Same reasoning as node_modules.
.pnpm-store/

# ─── Build output ────────────────────────────────────────────────────────────

# NestJS compiled JavaScript (apps/api/dist). Rebuilt by `nest build`;
# CI builds its own when it makes the Docker image.
dist/

# SvelteKit static build (apps/web/build) produced by adapter-static.
# Rebuilt by `vite build`; Caddy will serve a fresh copy built in CI.
build/

# SvelteKit's generated types and route manifest. Regenerated by
# `svelte-kit sync` (runs on install, dev, and check).
.svelte-kit/

# TypeScript incremental-build cache. Speeds up local rebuilds only and
# goes stale between machines.
*.tsbuildinfo

# Temporary files Vite writes while bundling its config; they are
# deleted automatically but can be left behind if a process crashes.
vite.config.*.timestamp-*

# NOTE: openapi.json and the generated types in packages/api-client are
# deliberately NOT ignored, so API contract changes show up in PR diffs
# (see docs/milestones/M0.md).

# ─── Secrets and environment ─────────────────────────────────────────────────

# Real environment files: database passwords, API keys, session secrets.
# The repo is public; anything committed here is leaked forever, even if
# deleted in a later commit.
.env
.env.*

# ...except the template, which lists every variable name with no values,
# so a fresh clone knows what to fill in.
!.env.example

# ─── Tests and coverage ──────────────────────────────────────────────────────

# Coverage reports from `vitest --coverage`. Generated per run; CI can
# produce and upload its own.
coverage/

# Playwright artifacts: screenshots, traces, and HTML reports from e2e runs.
# Useful for debugging a failure locally, noise in the repo.
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ─── Logs and runtime files ──────────────────────────────────────────────────

# Log files written by the apps or by package managers when they crash.
logs/
*.log

# Process ID files some tools write while running.
*.pid
*.pid.lock

# Node diagnostic reports (written on fatal errors). Can contain
# environment variables, so they must never be committed.
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ─── Editors and operating systems ───────────────────────────────────────────

# JetBrains IDE (WebStorm/IntelliJ) per-user project settings.
.idea/

# VS Code per-user settings...
.vscode/*

# ...except the shared extension recommendations (apps/web ships one
# recommending the Svelte extension), which help anyone who clones the repo.
!.vscode/extensions.json

# macOS Finder metadata, created in every folder you open.
.DS_Store

# Windows Explorer thumbnail cache.
Thumbs.db
